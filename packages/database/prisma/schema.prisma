generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum CmsUserSource {
  USER
  ADMIN
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum LessonType {
  THEORY
  PRACTICE
  CHALLENGE
  EXAM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum SubmissionStatus {
  PENDING
  COMPILING
  EVALUATING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
}

enum LeagueName {
  BRONCE
  PLATA
  ORO
  PLATINO
  DIAMANTE
  LEGENDARIO
}

enum RewardCategory {
  EXAMS
  PRACTICE
  ADVANTAGES
  SPECIALS
}

enum RewardType {
  EXAM_BONUS_POINT
  SMART_HINT
  DOUBLE_XP
}

enum RewardRedemptionStatus {
  COMPLETED
  REVOKED
}

enum UserRewardStatus {
  AVAILABLE
  ACTIVE
  USED
  EXPIRED
}

// ─── Auth / Users ────────────────────────────────────────

model User {
  id              String        @id @default(uuid())
  cmsUserId       Int
  cmsSource       CmsUserSource
  passwordHash    String?
  username        String        @unique
  email           String?
  displayName     String
  avatarObjectKey String?
  profileBanner   String        @default("BOSQUE")
  role            Role          @default(STUDENT)

  xp           Int       @default(0)
  gems         Int       @default(0)
  level        Int       @default(1)
  streak       Int       @default(0)
  lastActiveAt DateTime?

  submissions       Submission[]
  achievements      UserAchievement[]
  weeklyRankings    WeeklyRanking[]
  dailyMissions     DailyMission[]
  examAttempts      ExamAttempt[]
  notifications     Notification[]
  lessonCompletions LessonCompletion[]
  rewardRedemptions RewardRedemption[]
  rewards           UserReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cmsUserId, cmsSource])
  @@map("codi_user")
}

// ─── Ruta de Aprendizaje ─────────────────────────────────

model Island {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  description    String
  modelPath      String   @default("/islands/isla.glb")
  modelObjectKey String?
  available      Boolean  @default(true)
  accent         String   @default("#58cc02")
  order          Int
  courses        Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("codi_island")
}

model Course {
  id       String   @id @default(uuid())
  title    String
  slug     String   @unique
  level    Int
  region   String
  xpReward Int      @default(100)
  order    Int
  islandId String?
  island   Island?  @relation(fields: [islandId], references: [id], onDelete: SetNull)
  modules  Module[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("codi_course")
}

model Module {
  id       String   @id @default(uuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  title    String
  order    Int
  lessons  Lesson[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("codi_module")
}

model Lesson {
  id               String             @id @default(uuid())
  moduleId         String
  module           Module             @relation(fields: [moduleId], references: [id])
  title            String
  order            Int
  type             LessonType
  content          Json?
  imageObjectKey   String?
  imageFileName    String?
  imageContentType String?
  pdfObjectKey     String?
  pdfFileName      String?
  videoObjectKey   String?
  videoFileName    String?
  videoContentType String?
  xpReward         Int                @default(50)
  gemsReward       Int                @default(0)
  problems         Problem[]
  completions      LessonCompletion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("codi_lesson")
}

// ─── Seguimiento de Lecciones ───────────────────────────

model LessonCompletion {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completedAt DateTime @default(now())
  xpAwarded   Int      @default(0)
  gemsAwarded Int      @default(0)

  @@unique([userId, lessonId])
  @@map("codi_lesson_completion")
}

// ─── Tienda de Canjes ───────────────────────────────────

model Reward {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  description String
  category    RewardCategory
  cost        Int
  type        RewardType
  isActive    Boolean        @default(true)
  metadata    Json

  redemptions RewardRedemption[]
  userRewards UserReward[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("codi_reward")
}

model RewardRedemption {
  id        String                 @id @default(uuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId  String
  reward    Reward                 @relation(fields: [rewardId], references: [id])
  requestId String
  costPaid  Int
  status    RewardRedemptionStatus @default(COMPLETED)
  metadata  Json?

  entitlement UserReward?

  createdAt DateTime @default(now())

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@map("codi_reward_redemption")
}

model UserReward {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardId     String
  reward       Reward           @relation(fields: [rewardId], references: [id])
  redemptionId String           @unique
  redemption   RewardRedemption @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  slotKey      String
  status       UserRewardStatus
  metadata     Json?
  activatedAt  DateTime?
  expiresAt    DateTime?
  usedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, rewardId, status, expiresAt])
  @@index([userId, rewardId, slotKey])
  @@map("codi_user_reward")
}

// ─── Problemas (solo referencia a CMS) ───────────────────

model Problem {
  id          String     @id @default(uuid())
  cmsTaskId   Int        @unique
  cmsTaskName String
  title       String
  difficulty  Difficulty @default(EASY)
  xpReward    Int        @default(50)
  gemsReward  Int        @default(0)

  lessonId String?
  lesson   Lesson? @relation(fields: [lessonId], references: [id])
  order    Int     @default(0)

  content       Json?
  attachmentUrl String?

  submissions  Submission[]
  examProblems ExamProblem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("codi_problem")
}

// ─── Evaluaciones ────────────────────────────────────────

model Submission {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  problemId String
  problem   Problem          @relation(fields: [problemId], references: [id])
  code      String
  language  String           @default("python")
  status    SubmissionStatus @default(PENDING)
  score     Float?

  cmsSubmissionId Int?  @unique
  cmsResults      Json?

  submittedAt DateTime  @default(now())
  evaluatedAt DateTime?
  gemsAwarded Boolean   @default(false)
  xpAwarded   Int       @default(0)

  evaluationAttempts  Int       @default(0)
  evaluationLeaseUntil DateTime?
  evaluationWorkerId   String?
  evaluationStartedAt  DateTime?

  @@index([status, evaluationLeaseUntil, submittedAt])
  @@map("codi_submission")
}

// ─── Gamificación ────────────────────────────────────────

model Achievement {
  id          String            @id @default(uuid())
  code        String            @unique
  title       String
  description String
  iconUrl     String?
  xpReward    Int               @default(0)
  users       UserAchievement[]

  @@map("codi_achievement")
}

model UserAchievement {
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@id([userId, achievementId])
  @@map("codi_user_achievement")
}

model League {
  id       String          @id @default(uuid())
  name     LeagueName      @unique
  minXp    Int             @default(0)
  maxXp    Int?
  order    Int
  rankings WeeklyRanking[]

  @@map("codi_league")
}

model WeeklyRanking {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekStart DateTime
  xpEarned  Int      @default(0)
  position  Int?
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id])

  @@unique([userId, weekStart])
  @@map("codi_weekly_ranking")
}

model DailyMission {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  description String
  type        String
  target      Int
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  xpReward    Int      @default(50)
  claimed     Boolean  @default(false)

  @@unique([userId, date, type])
  @@map("codi_daily_mission")
}

// ─── Exámenes ────────────────────────────────────────────

model Exam {
  id          String        @id @default(uuid())
  title       String
  description String?
  courseId    String?
  duration    Int
  startAt     DateTime?
  endAt       DateTime?
  xpReward    Int           @default(200)
  problems    ExamProblem[]
  attempts    ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("codi_exam")
}

model ExamProblem {
  examId    String
  exam      Exam    @relation(fields: [examId], references: [id])
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id])
  points    Int     @default(100)
  order     Int

  @@id([examId, problemId])
  @@map("codi_exam_problem")
}

model ExamAttempt {
  id      String       @id @default(uuid())
  examId  String
  exam    Exam         @relation(fields: [examId], references: [id])
  userId  String
  user    User         @relation(fields: [userId], references: [id])
  startAt DateTime     @default(now())
  endAt   DateTime?
  score   Float?
  answers ExamAnswer[]

  createdAt DateTime @default(now())

  @@map("codi_exam_attempt")
}

model ExamAnswer {
  id            String           @id @default(uuid())
  attemptId     String
  attempt       ExamAttempt      @relation(fields: [attemptId], references: [id])
  examProblemId String
  code          String
  status        SubmissionStatus @default(PENDING)
  score         Float?
  submittedAt   DateTime         @default(now())

  @@map("codi_exam_answer")
}

// ─── Notificaciones ─────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("codi_notification")
}
