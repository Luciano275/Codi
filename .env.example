# ⚠️  COPIA ESTE ARCHIVO A .env Y COMPLETA CON VALORES REALES
# ⚠️  NUNCA USES LOS VALORES POR DEFECTO EN PRODUCCIÓN

# ─── Database ───
# Usar una base de datos dedicada para Codi.
DATABASE_URL="postgresql://cmsuser:your_strong_password_here@localhost:5432/cmsdb"

# ─── JWT ───
# GENERA UN SECRET FUERTE: openssl rand -base64 64
JWT_SECRET=""
JWT_EXPIRES_IN="1d"      # Reducido de 7d. Usar refresh para sesiones largas.

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD="openssl rand -hex 64"

# ─── Frontend URL (CORS) ───
FRONTEND_URL="http://localhost:3000"

# ─── API ───
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── S3 ───
AWS_REGION="us-east-2"
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY=""
AWS_SECRET_KEY=""
# Opcional: endpoint compatible con S3 (MinIO, R2, etc.). Dejar vacío para AWS S3.
S3_ENDPOINT=""
# 24 horas
S3_SIGNED_READ_EXPIRES_IN="86400"

# ─── Evaluation (TypeScript orchestrator + native isolate) ───
EVAL_ISOLATE_BIN="/usr/local/bin/isolate"
EVAL_FIRST_BOX_ID=200
EVAL_LAST_BOX_ID=299
EVAL_SUBMISSION_CONCURRENCY=2
EVAL_TESTCASE_CONCURRENCY=4
EVAL_COMPILE_CONCURRENCY=1
EVAL_CACHE_TTL_MS=300000
EVAL_QUEUE_POLL_MS=250
EVAL_LEASE_SECONDS=600
EVAL_MAX_ATTEMPTS=3
EVAL_MAX_OUTPUT_KB=102400
PLAYGROUND_FIRST_BOX_ID=300
PLAYGROUND_LAST_BOX_ID=399
