# ─── Database ───
DATABASE_URL="postgresql://cmsuser:your_password_here@localhost:5432/cmsdb"

# ─── JWT ───
JWT_SECRET="change-this-to-a-random-secret"
JWT_EXPIRES_IN="7d"

# ─── Redis ───
REDIS_URL="redis://localhost:6379"

# ─── Frontend URL (CORS) ───
FRONTEND_URL="http://localhost:3000"

# ─── API ───
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── S3 ───
S3_BUCKET="codi"
S3_REGION="us-east-1"
S3_ENDPOINT=""

