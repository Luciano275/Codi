# ⚠️  COPIA ESTE ARCHIVO A .env Y COMPLETA CON VALORES REALES
# ⚠️  NUNCA USES LOS VALORES POR DEFECTO EN PRODUCCIÓN

# ─── Database ───
# Usar una base de datos dedicada para Codi.
DATABASE_URL="postgresql://cmsuser:your_strong_password_here@localhost:5432/cmsdb"

# ─── JWT ───
# GENERA UN SECRET FUERTE: openssl rand -base64 64
JWT_SECRET=""
JWT_EXPIRES_IN="1d"      # Reducido de 7d. Usar refresh para sesiones largas.

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD="openssl rand -hex 64"

# ─── Frontend URL (validación de origen) ───
FRONTEND_URL="http://localhost:3000"

# ─── API ───
API_PORT=4000
# Solo para procesos server-side de Next.js. Nunca exponer como NEXT_PUBLIC_*.
API_URL="http://localhost:4000"

# ─── S3 ───
AWS_REGION="us-east-2"
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY=""
AWS_SECRET_KEY=""
# Opcional: endpoint compatible con S3 (MinIO, R2, etc.). Dejar vacío para AWS S3.
S3_ENDPOINT=""
# 24 horas
S3_SIGNED_READ_EXPIRES_IN="86400"

# ─── Evaluation (API orchestrator + Cloudflare Sandbox Worker) ───
# Solo API NestJS + Worker. No configurar este secreto en el servicio web.
# Generar con: openssl rand -hex 32
# En producción, configura el mismo secreto con `wrangler secret put WORKER_EVALUATOR_TOKEN`
# dentro de apps/evaluator.
EVALUATOR_URL="http://localhost:8787"
WORKER_EVALUATOR_TOKEN=""
EVALUATOR_REQUEST_TIMEOUT_MS=195000
EVAL_SUBMISSION_CONCURRENCY=2
EVAL_TESTCASE_CONCURRENCY=4
EVAL_COMPILE_CONCURRENCY=1
EVAL_CACHE_TTL_MS=300000
EVAL_QUEUE_POLL_MS=250
EVAL_LEASE_SECONDS=600
EVAL_MAX_ATTEMPTS=3
EVAL_MAX_OUTPUT_KB=1024
