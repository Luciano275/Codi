# ─── Database ───
DATABASE_URL="postgresql://cmsuser:your_password_here@localhost:5432/cmsdb"

# ─── CMS ───
CMS_API_URL="http://localhost:8888"
CMS_ADMIN_TOKEN=""

# ─── JWT ───
JWT_SECRET="change-this-to-a-random-secret"
JWT_EXPIRES_IN="7d"

# ─── Redis ───
REDIS_URL="redis://localhost:6379"

# ─── Frontend URL (CORS) ───
FRONTEND_URL="http://localhost:3000"

# ─── API ───
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── CMS Adapter ───
CMS_ADAPTER_PORT=4001
CMS_CONTEST_NAME="simulacro"
BRIDGE_PORT=4002
BRIDGE_POLL_INTERVAL=500

# ─── S3 ───
S3_BUCKET="codi"
S3_REGION="us-east-1"
S3_ENDPOINT=""
