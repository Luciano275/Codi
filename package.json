{
  "name": "codi",
  "private": true,
  "scripts": {
    "start:dev": "turbo dev",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @codi/database db:generate",
    "db:setup": "pnpm --filter @codi/database db:setup",
    "db:push": "pnpm --filter @codi/database db:push",
    "db:migrate": "pnpm --filter @codi/database db:migrate",
    "db:migrate:dev": "pnpm --filter @codi/database db:migrate:dev",
    "db:seed": "pnpm --filter @codi/database db:seed",
    "db:studio": "pnpm --filter @codi/database db:studio"
  },
  "devDependencies": {
    "@turbo/gen": "^2.5.0",
    "@types/bcryptjs": "^3.0.0",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.10.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
