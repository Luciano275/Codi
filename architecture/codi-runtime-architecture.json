  "cards": [
    {
      "dot": "cyan",
      "title": "Primary request",
      "items": [
        "Next.js forwards session cookies as Bearer tokens to NestJS /api endpoints.",
        "NestJS validates, authorizes, and persists learning, rewards, rankings, and submissions via Prisma."
      ]
    },
    {
      "dot": "amber",
      "title": "Evaluation path",
      "items": [
        "Submissions persist as EVALUATING; an in-process DB-backed worker claims, retries, and completes jobs.",
        "The API sends bounded source and tests to Cloudflare; the Sandbox runs code with Internet disabled."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "The public browser is separated from the trusted server/data plane by JWT, CSRF, roles, and API controls.",
        "PostgreSQL hosts Codi codi_* and CMS public.* tables; S3 holds objects and Redis is best-effort cache."
      ]
    }
  ]
